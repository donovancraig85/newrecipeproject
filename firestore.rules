rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Family member profiles.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isAdmin();

      // Each signed-in person can manage only their own favorites.
      match /favorites/{recipeId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Shared family recipe library.
    match /recipes/{recipeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isAdmin();

      // Signed-in users can read and post comments.
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // Deny any document path not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
